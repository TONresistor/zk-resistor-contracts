{
  "name": "zkresistor-circuits",
  "version": "2.0.0",
  "description": "ZK circuits for ZKResistor: Poseidon BLS12-381 over a Merkle tree of depth 20.",
  "private": true,
  "type": "module",
  "scripts": {
    "precompile": "mkdir -p build",
    "compile:insert": "circom insert.circom --r1cs --wasm --sym -o build/ -p bls12381 -l node_modules",
    "compile:withdraw": "circom withdraw.circom --r1cs --wasm --sym -o build/ -p bls12381 -l node_modules",
    "compile:hasher": "circom hasher.circom --r1cs --wasm --sym -o build/ -p bls12381 -l node_modules",
    "compile": "npm run compile:insert && npm run compile:withdraw && npm run compile:hasher",
    "check:constraints": "node scripts/check-constraints.js",
    "check:toolchain": "node scripts/check-toolchain.js",
    "check:zeros": "node scripts/check-zeros.js",
    "export:vk:insert": "mkdir -p vk && snarkjs zkey export verificationkey build/insert_final.zkey vk/insert_vk.json",
    "export:vk:withdraw": "mkdir -p vk && snarkjs zkey export verificationkey build/withdraw_final.zkey vk/withdraw_vk.json",
    "vk-to-tolk:insert": "node scripts/vk-to-tolk.js vk/insert_vk.json INSERT > ../contracts/verifier-insert-vk.tolk",
    "vk-to-tolk:withdraw": "node scripts/vk-to-tolk.js vk/withdraw_vk.json WITHDRAW > ../contracts/verifier-withdraw-vk.tolk"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "circomlib": "2.0.5",
    "poseidon-bls12381-circom": "1.0.0",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "@ton/core": "0.63.0",
    "circom_tester": "0.0.20"
  },
  "overrides": {
    "bfj": "9.1.3",
    "tmp": "0.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "config": {
    "circom_version": "2.2.3",
    "constraint_baseline": {
      "insert": 25105,
      "withdraw": 14537,
      "hasher": 624
    }
  }
}
